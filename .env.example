# Environment Variables for Blockchain Integration

# Smart Contract Address (Deploy MedicalRecordsStorage.sol and add address here)
VITE_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# Pinata IPFS Configuration
# Get these from https://app.pinata.cloud
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET_KEY=your_pinata_secret_key_here

# Optional: Custom IPFS Gateway
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Optional: Custom RPC Endpoint (defaults to public Mumbai)
VITE_RPC_URL=https://rpc-mumbai.maticvigil.com
